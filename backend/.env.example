# NZT Area Clienti API - environment template. Copy to .env (git-ignored) for local dev.
# NEVER commit real values. In production set these as Railway service variables.
# Values marked [PROD] are mandatory when NZT_ENVIRONMENT=production (startup aborts).

NZT_ENVIRONMENT=development            # development | test | production
NZT_LOG_LEVEL=INFO

# --- Public URLs (no trailing slash, origin only) ---
NZT_API_PUBLIC_BASE_URL=https://api.nztsolutions.it        # JWT iss + DPoP htu base
NZT_PORTAL_ORIGINS=https://clienti.nztsolutions.it         # CORS allow-list (comma separated)
NZT_ADMIN_ORIGINS=https://admin.nztsolutions.it            # Admin CORS + CSP allow-list
NZT_STORAGE_PUBLIC_ORIGIN=https://storage.nztsolutions.it  # CSP connect-src

# --- MongoDB (external cluster, e.g. Atlas; one DATABASE per service on a shared cluster) ---
# Runtime user = custom role limited to find/insert/update/remove on this API's collections
# (database/create_roles.py; on Atlas: Database Access -> Custom Roles). Never the cluster admin.
# [PROD] must be set explicitly, with credentials; TLS is mandatory (certificate + hostname verified)
# and tlsInsecure / tlsAllowInvalidCertificates / tlsAllowInvalidHostnames / tls=false are refused.
NZT_MONGODB_URI=mongodb+srv://nzt_app:CHANGE_ME@CLUSTER.mongodb.net/?authSource=admin
NZT_MONGODB_DATABASE=nzt               # [PROD] explicit
# Used ONLY by `python -m app.schema` (validators + indexes) and the one-shot data migration.
# Do NOT set it on the API service: the API must not hold the schema user's credentials.
NZT_MONGODB_MIGRATIONS_URI=mongodb+srv://nzt_migrator:CHANGE_ME@CLUSTER.mongodb.net/?authSource=admin
NZT_MONGODB_TLS=                       # default: true in production (required), false elsewhere
NZT_MONGODB_TLS_CA_FILE=               # CA bundle only if the server CA is not a system CA
NZT_MONGODB_MAX_POOL_SIZE=10
NZT_MONGODB_TIMEOUT_MS=15000           # client-side timeout of every operation
NZT_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Redis ---
# [PROD] must be set explicitly
NZT_REDIS_URL=redis://default:CHANGE_ME@redis.railway.internal:6379/0

# --- Access tokens ---
# [PROD] Ed25519 PKCS#8 PEM. Generate:  openssl genpkey -algorithm ed25519
NZT_ACCESS_TOKEN_PRIVATE_KEY_PEM=
NZT_ACCESS_TOKEN_TTL_SECONDS=600       # 300..600 (spec: 5-10 min)
NZT_REFRESH_TOKEN_TTL_SECONDS=604800   # cookie Max-Age (spec: 7 days)

# --- DPoP / passwords / HTTP ---
NZT_DPOP_IAT_LEEWAY_SECONDS=60
NZT_ARGON2_MAX_CONCURRENCY=2           # each verify uses 64 MiB RAM
NZT_ARGON2_MAX_QUEUE=8                 # max calls waiting for a slot; beyond -> 503 + Retry-After
# [PROD] CIDRs of the reverse proxies in front of the API (e.g. 100.64.0.0/10 on Railway).
# Empty = ignore X-Forwarded-For (socket peer is the client). In production set EITHER this
# OR the explicit opt-in NZT_DIRECT_CLIENT_CONNECTIONS=true (no proxy in front), never both.
NZT_TRUSTED_PROXY_CIDRS=
NZT_DIRECT_CLIENT_CONNECTIONS=false
NZT_MAX_REQUEST_BODY_BYTES=16384

# --- Google OIDC ---
NZT_GOOGLE_CLIENT_ID=                  # [PROD]
NZT_GOOGLE_CLIENT_SECRET=              # [PROD]
NZT_GOOGLE_REDIRECT_URI=https://clienti.nztsolutions.it/auth/google/callback
# [PROD] AES-256-GCM key for the OAuth state cookie, base64url of 32 random bytes:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
NZT_OAUTH_STATE_KEY=

# --- Object storage (S3/R2, SigV4 presign) ---
NZT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # [PROD] must be https
NZT_STORAGE_REGION=auto
NZT_STORAGE_BUCKET=nzt-binaries
NZT_STORAGE_ACCESS_KEY_ID=             # [PROD] read-only key scoped to the bucket
NZT_STORAGE_SECRET_ACCESS_KEY=         # [PROD]
NZT_STORAGE_ADDRESSING_STYLE=path
NZT_LAUNCHER_VERSION=1.0.0
NZT_LAUNCHER_SHA256=                   # [PROD] 64 lowercase hex chars of the published binary

# --- Transactional email (email verification) ---
NZT_MAIL_BACKEND=console               # [PROD] must be resend (console | file | memory dev/test only)
NZT_RESEND_API_KEY=                    # [PROD] required when NZT_MAIL_BACKEND=resend
NZT_MAIL_FROM=                         # [PROD] e.g. NZT Solutions <noreply@nztsolutions.it>
NZT_MAIL_FILE_DIR=                     # only when NZT_MAIL_BACKEND=file
NZT_MAIL_HTTP_TIMEOUT_SECONDS=10.0
NZT_EMAIL_VERIFICATION_TTL_SECONDS=86400
