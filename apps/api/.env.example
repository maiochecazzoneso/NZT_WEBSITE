# NZT Area Clienti API - environment template. Copy to .env (git-ignored) for local dev.
# NEVER commit real values. In production set these as Railway service variables.
# Values marked [PROD] are mandatory when NZT_ENVIRONMENT=production (startup aborts).

NZT_ENVIRONMENT=development            # development | test | production
NZT_LOG_LEVEL=INFO

# --- Public URLs (no trailing slash, origin only) ---
NZT_API_PUBLIC_BASE_URL=https://api.nztsolutions.it        # JWT iss + DPoP htu base
NZT_PORTAL_ORIGINS=https://clienti.nztsolutions.it         # CORS allow-list (comma separated)
NZT_STORAGE_PUBLIC_ORIGIN=https://storage.nztsolutions.it  # CSP connect-src

# --- PostgreSQL (runtime role = DML only; migrator role = DDL) ---
NZT_DATABASE_URL=postgresql://nzt_app:CHANGE_ME@postgres.railway.internal:5432/nzt
NZT_MIGRATIONS_DATABASE_URL=postgresql://nzt_migrator:CHANGE_ME@postgres.railway.internal:5432/nzt
NZT_DATABASE_SSLMODE=verify-full       # [PROD] verify-full|verify-ca (default verify-full in prod, disable otherwise)
NZT_DATABASE_SSL_ROOT_CERT=            # path to CA bundle for verify-full/verify-ca
NZT_DATABASE_POOL_SIZE=10
NZT_DATABASE_MAX_OVERFLOW=5

# --- Redis ---
NZT_REDIS_URL=redis://default:CHANGE_ME@redis.railway.internal:6379/0

# --- Access tokens ---
# [PROD] Ed25519 PKCS#8 PEM. Generate:  openssl genpkey -algorithm ed25519
NZT_ACCESS_TOKEN_PRIVATE_KEY_PEM=
NZT_ACCESS_TOKEN_TTL_SECONDS=600       # 300..600 (spec: 5-10 min)
NZT_REFRESH_TOKEN_TTL_SECONDS=604800   # cookie Max-Age (spec: 7 days)

# --- DPoP / passwords / HTTP ---
NZT_DPOP_IAT_LEEWAY_SECONDS=60
NZT_ARGON2_MAX_CONCURRENCY=2           # each verify uses 64 MiB RAM
NZT_TRUSTED_PROXY_CIDRS=               # e.g. 100.64.0.0/10 ; empty = ignore X-Forwarded-For
NZT_MAX_REQUEST_BODY_BYTES=16384

# --- Google OIDC ---
NZT_GOOGLE_CLIENT_ID=                  # [PROD]
NZT_GOOGLE_CLIENT_SECRET=              # [PROD]
NZT_GOOGLE_REDIRECT_URI=https://clienti.nztsolutions.it/auth/google/callback
# [PROD] AES-256-GCM key for the OAuth state cookie, base64url of 32 random bytes:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
NZT_OAUTH_STATE_KEY=

# --- Object storage (S3/R2, SigV4 presign) ---
NZT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
NZT_STORAGE_REGION=auto
NZT_STORAGE_BUCKET=nzt-binaries
NZT_STORAGE_ACCESS_KEY_ID=             # [PROD] read-only key scoped to the bucket
NZT_STORAGE_SECRET_ACCESS_KEY=         # [PROD]
NZT_STORAGE_ADDRESSING_STYLE=path
NZT_LAUNCHER_VERSION=1.0.0
NZT_LAUNCHER_SHA256=                   # [PROD] 64 lowercase hex chars of the published binary
