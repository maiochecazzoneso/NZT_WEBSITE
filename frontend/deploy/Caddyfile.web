# Portale clienti (host di default) + dashboard admin (host ADMIN_HOST) nello stesso container.
# Variabili a runtime: PORT (default 8080), API_ORIGIN (origin dell'API = VITE_API_BASE_URL usato in build),
# ADMIN_HOST (solo hostname, es. admin.nztsolutions.it). Header allineati a csp.config.ts.
{
	admin off
	auto_https off
}

(security_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src {$API_ORIGIN:https://api.nztsolutions.it}; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
}

(spa_files) {
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed zstd gzip
		}
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed zstd gzip
		}
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# Controllo di salute della piattaforma (frontend/deploy/railway.web.json)
	handle /healthz {
		header -Server
		respond "ok" 200
	}

	@admin host {$ADMIN_HOST:admin.localhost}

	handle @admin {
		root * /srv/admin
		import security_headers
		import spa_files
	}

	handle {
		root * /srv/portal
		import security_headers
		import spa_files
	}
}
