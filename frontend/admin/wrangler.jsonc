// Cloudflare Workers (solo asset statici) per il admin. Build: pnpm build:admin (dalla radice del repo).
// Deploy:        npx wrangler deploy --config frontend/admin/wrangler.jsonc
// Altri branch:  npx wrangler versions upload --config frontend/admin/wrangler.jsonc
// "name" deve coincidere con il nome del Worker creato nella dashboard Cloudflare.
{
  "name": "nzt-admin-test",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // SPA: le rotte client (/accedi, /download, ...) servono index.html
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true,
  "previews": {}
}
