# Copia in .env per lo sviluppo locale. In produzione le variabili si impostano su Railway (Variables).

# Cloudflare Turnstile — dashboard Cloudflare → Turnstile → Add widget (hostname: nztsolutions.it)
# Le chiavi qui sotto sono le chiavi di TEST ufficiali di Cloudflare: la verifica passa sempre.
# NB: la chiave pubblica viene incorporata nel bundle al momento del build.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend — https://resend.com/api-keys (il dominio del mittente va verificato su Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@nztsolutions.it
CONTACT_FROM_EMAIL="NZT Solutions <sito@nztsolutions.it>"
