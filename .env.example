# Copia in .env per lo sviluppo locale. In produzione le variabili si impostano su Railway (Variables).
# Nessun valore reale va mai scritto in questo file: è versionato.

# Cloudflare Turnstile — dashboard Cloudflare → Turnstile → Add widget (hostname: nztsolutions.it)
# Le chiavi qui sotto sono le chiavi di TEST ufficiali di Cloudflare: la verifica passa sempre.
# NB: la chiave pubblica viene incorporata nel bundle al momento del build.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Facoltativo ma raccomandato in produzione: hostname (separati da virgola) su cui il token deve essere
# stato emesso. Es.: nztsolutions.it,www.nztsolutions.it — con le chiavi di test va lasciato vuoto.
TURNSTILE_ALLOWED_HOSTNAMES=

# Resend — https://resend.com/api-keys (il dominio del mittente va verificato su Resend)
# Usare una chiave con permesso "Sending access" limitato al solo dominio del sito.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@nztsolutions.it
CONTACT_FROM_EMAIL="NZT Solutions <sito@nztsolutions.it>"

# Origin IP Cloaking — solo produzione (letto da server/index.mjs, non da Astro).
# 64 caratteri esadecimali:  openssl rand -hex 32
# Lo stesso valore va inserito in Cloudflare (Transform Rule che aggiunge l'header X-Origin-Verify).
# Se impostato, ogni richiesta priva dell'header riceve 403 (tranne /healthz).
ORIGIN_VERIFY_SECRET=
