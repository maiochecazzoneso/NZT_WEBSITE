{
  "name": "nzt-solutions-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./server/index.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "serve": "node ./server/index.mjs",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "audit:deps": "pnpm audit --audit-level=high",
    "dev:portal": "pnpm --filter @nzt/portal dev",
    "build:portal": "pnpm --filter @nzt/portal build",
    "test:portal": "pnpm --filter @nzt/portal test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@nanostores/react": "^0.7.3",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "nanostores": "^0.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.0.0",
    "three": "^0.172.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "lightningcss": "^1.32.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "packageExtensions": {
      "@astrojs/astro2tsx@*": {
        "dependencies": {
          "@emnapi/runtime": "1.11.3"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
