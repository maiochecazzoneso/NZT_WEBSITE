{
  "name": "nzt-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "NZT Solutions: frontend/ (sito, portale, dashboard, design system), backend/ (API), database/ (MongoDB)",
  "scripts": {
    "dev": "pnpm --filter nzt-solutions-web dev",
    "build": "pnpm --filter nzt-solutions-web build",
    "serve": "pnpm --filter nzt-solutions-web serve",
    "lint": "pnpm --filter nzt-solutions-web lint",
    "test": "pnpm --filter nzt-solutions-web test",
    "dev:portal": "pnpm --filter @nzt/portal dev",
    "build:portal": "pnpm --filter @nzt/portal build",
    "test:portal": "pnpm --filter @nzt/portal test",
    "dev:admin": "pnpm --filter @nzt/admin dev",
    "build:admin": "pnpm --filter @nzt/admin build",
    "test:admin": "pnpm --filter @nzt/admin test",
    "format": "prettier --write .",
    "audit:deps": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "packageExtensions": {
      "@astrojs/astro2tsx@*": {
        "dependencies": {
          "@emnapi/runtime": "1.11.3"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
