{
  "name": "nzt-solutions",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:landing": "pnpm --filter @nzt/landing dev",
    "build:landing": "pnpm --filter @nzt/landing build",
    "preview:landing": "pnpm --filter @nzt/landing preview",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
