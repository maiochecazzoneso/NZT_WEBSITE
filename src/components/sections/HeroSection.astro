---
// src/components/sections/HeroSection.astro
// v2.1: primo schermo senza testo (solo pillola + "Scroll to Open"); stage-2 e navbar animati da src/lib/hero-scroll.ts,
// indipendente dall'isola WebGL. h1 e copy del primo schermo da definire (punto aperto SEO).
import HeroPillScrollytelling from '@interactive/HeroPillScrollytelling';
---

<!-- Fallback SEO e No-JS: se JS è disattivato, il blocco testuale (stage-2) è subito visibile -->
<noscript>
  <style>
    #hero-scrolly-wrapper {
      height: auto !important;
      min-height: 100vh;
      padding: 8rem 0;
    }
    /* Senza JS il box sticky (h-screen + overflow-hidden) taglierebbe il testo sui viewport bassi */
    #hero-scrolly-wrapper > div {
      height: auto !important;
    }
    /* stage-2 centrato: con position relative, inset-x-6 lo sposterebbe di 1.5rem a destra; */
    /* scala piena: in Tailwind v4 scale-[0.78] usa la proprietà CSS scale, ignorata da transform */
    #hero-stage-2 {
      opacity: 1 !important;
      transform: none !important;
      position: relative !important;
      pointer-events: auto !important;
      margin-bottom: 3rem;
      left: auto !important;
      right: auto !important;
      scale: none !important;
    }
    /* "Scroll to Open" non ha senso senza JS e si sovrapporrebbe alle CTA */
    #hero-scroll-hint {
      display: none !important;
    }
  </style>
</noscript>

<section
  id="hero-scrolly-wrapper"
  class="relative h-[320vh] w-full border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]"
>
  <!-- Viewport Fissato durante i 320vh di scroll -->
  <div class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden">
    <!-- Bagliore centrale monocromatico modulato dallo scroll -->
    <div
      id="hero-core-glow"
      class="gpu-accelerated pointer-events-none absolute h-[380px] w-[380px] rounded-full opacity-20 blur-[120px] sm:h-[520px] sm:w-[520px]"
      style="background: radial-gradient(circle, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0) 70%);"
      aria-hidden="true"
    >
    </div>

    <!-- LIVELLO 1 (z-10): Scena 3D a Tutto Schermo (Idratata in client:idle) -->
    <div class="absolute inset-0 z-10 flex items-center justify-center">
      <HeroPillScrollytelling client:idle />
    </div>

    <!-- LIVELLO 2 (z-20): Testi SEO Centrati Sincronizzati con l'Apertura della Pillola -->
    <div
      class="pointer-events-none relative z-20 mx-auto flex w-full max-w-5xl flex-col items-center justify-center px-6 text-center"
    >
      <!-- FASE 2 (Emerge dall'interno della Pillola quando si apre tra il 30% e il 75% dello scroll) -->
      <div
        id="hero-stage-2"
        class="gpu-accelerated pointer-events-none absolute inset-x-6 flex scale-[0.78] flex-col items-center justify-center space-y-8 opacity-0"
      >
        <div
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/[0.04] px-3.5 py-1 backdrop-blur-md"
        >
          <span class="font-mono text-xs tracking-widest text-white uppercase">
            Core Architecture Unlocked
          </span>
        </div>

        <h2
          class="text-metallic max-w-3xl text-3xl leading-[1.08] font-semibold tracking-tight sm:text-5xl lg:text-6xl"
        >
          Software su misura, Ecosistemi Web Zero-Latency & SEO Nativa.
        </h2>

        <p
          class="max-w-2xl text-base leading-relaxed font-normal text-[var(--text-muted)] sm:text-xl"
        >
          Costruiamo piattaforme ultra-veloci progettate per dominare i motori di ricerca,
          automatizzare i processi critici e convertire i visitatori in clienti.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a
            href="#contatti"
            class="inline-flex items-center justify-center rounded-lg bg-white px-7 py-3.5 text-sm font-medium text-[#050505] shadow-[0_0_30px_rgba(255,255,255,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-zinc-200"
          >
            Inizia un Progetto
          </a>
          <a
            href="#servizi"
            class="inline-flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[#0c0c0e]/90 px-7 py-3.5 text-sm font-medium text-white backdrop-blur-md transition-all duration-300 hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)]"
          >
            Esplora i Servizi
          </a>
        </div>
      </div>
    </div>

    <!-- Indicatore di Scroll Minimalista in Basso -->
    <div
      id="hero-scroll-hint"
      class="pointer-events-none absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-2"
    >
      <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--text-subtle)] uppercase">
        Scroll to Open
      </span>
      <div class="h-9 w-[1px] bg-gradient-to-b from-white/50 to-transparent"></div>
    </div>
  </div>
</section>

<style is:global>
  /* Navbar nascosta al primo paint finché la pillola non ha concluso il fly-out (solo pagine con la Hero: questo
     CSS viaggia con il componente). html.nav-gate è impostata in <head> da MainLayout solo con JS attivo e senza
     #ancora nell'URL; la rimuovono src/lib/hero-scroll.ts (da lì in poi la navbar è guidata da GSAP) o lo script
     qui sotto se il modulo non si carica. Niente pointer-events: visibility hidden basta e il failsafe lo annulla. */
  html.nav-gate #site-header {
    opacity: 0;
    visibility: hidden;
    /* Failsafe solo CSS: se nessuno script rimuove il gate, la navbar ricompare comunque dopo 10 s */
    animation: nav-gate-failsafe 0.6s cubic-bezier(0.16, 1, 0.3, 1) 10s both;
    animation-play-state: running !important;
  }

  @keyframes nav-gate-failsafe {
    to {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  // Avvio della timeline DOM della Hero (src/lib/hero-scroll.ts): import dinamico dopo load + idle, come gsap-init
  // in MainLayout, così GSAP (chunk condiviso) resta fuori dal budget JS iniziale (< 35 KB). Indipendente dall'isola 3D.
  const NAV_GATE_CLASS = 'nav-gate';
  const wrapper = document.getElementById('hero-scrolly-wrapper');
  const ungate = () => document.documentElement.classList.remove(NAV_GATE_CLASS);
  // Failsafe se il modulo non si carica: navbar visibile e testi della Hero statici e cliccabili (come senza JS).
  // pointer-events inline come fa la timeline: il contenitore padre è pointer-events-none (proprietà ereditata).
  const failsafe = () => {
    ungate();
    const stage2Text = document.getElementById('hero-stage-2');
    if (stage2Text)
      Object.assign(stage2Text.style, { opacity: '1', scale: '1', pointerEvents: 'auto' });
  };

  if (!wrapper) {
    ungate();
  } else {
    // Prima che il modulo sia pronto: se la pagina si apre (o viene ricaricata) già oltre la Hero, navbar visibile
    const onScroll = () => {
      if (wrapper.getBoundingClientRect().bottom <= window.innerHeight + 1) ungate();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const boot = () => {
      import('@/lib/hero-scroll')
        .then(({ initHeroScroll }) => initHeroScroll(wrapper))
        .catch(failsafe)
        .finally(() => window.removeEventListener('scroll', onScroll));
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(boot, { timeout: 2000 });
      } else {
        setTimeout(boot, 200);
      }
    };

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  }
</script>
