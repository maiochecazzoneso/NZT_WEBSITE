---
// src/components/sections/HeroSection.astro
// v3.0 particle-to-text: primo schermo senza testo (solo pillola con le particelle nel nucleo + indicatore di scroll).
// Le particelle (isola WebGL) compongono "ZERO ATTRITO / OPERATIVO" esattamente sopra il testo reale, che subentra
// con un cross-fade (timeline DOM in src/lib/hero-scroll.ts, indipendente dall'isola); con esso emergono badge,
// h1 SEO, sottotitolo e CTA (Specifica Contenuti §3 Sezione 1).
import HeroPillScrollytelling from '@interactive/HeroPillScrollytelling';
import { hero } from '@/content/site';
---

<!-- Fallback SEO e No-JS: se JS è disattivato, headline, h1, sottotitolo e CTA (stage-2) sono subito visibili -->
<noscript>
  <style>
    #hero-scrolly-wrapper {
      height: auto !important;
      min-height: 100vh;
      padding: 8rem 0;
    }
    /* Senza JS il box sticky (h-screen + overflow-hidden) taglierebbe il testo sui viewport bassi */
    #hero-scrolly-wrapper > div {
      height: auto !important;
    }
    #hero-stage-2,
    #hero-stage-2-headline,
    [data-particle-subreveal] {
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
    }
    /* stage-2 nel flusso e centrato: con position relative, inset-x-6 lo sposterebbe di 1.5rem a destra */
    #hero-stage-2 {
      position: relative !important;
      left: auto !important;
      right: auto !important;
      margin-bottom: 3rem;
    }
    /* L'indicatore di scroll non ha senso senza JS e si sovrapporrebbe alle CTA */
    #hero-scroll-hint {
      display: none !important;
    }
  </style>
</noscript>

<section
  id="hero-scrolly-wrapper"
  class="relative h-[360vh] w-full border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]"
>
  <!-- Contenitore Sticky fissato durante i 360vh di scrollytelling -->
  <div class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden">
    <!-- Bagliore centrale monocromatico modulato dall'esplosione particellare -->
    <div
      id="hero-core-glow"
      class="gpu-accelerated pointer-events-none absolute h-[380px] w-[380px] rounded-full opacity-15 blur-[130px] sm:h-[540px] sm:w-[540px]"
      style="background: radial-gradient(circle, rgba(255,255,255,0.24) 0%, rgba(255,255,255,0) 70%);"
      aria-hidden="true"
    >
    </div>

    <!-- LIVELLO 1 (z-10): Canvas WebGL a Tutto Schermo (Pillola 3D + Sciame Particelle Tipografiche) -->
    <div class="absolute inset-0 z-10 flex items-center justify-center">
      <HeroPillScrollytelling client:idle />
    </div>

    <!-- LIVELLO 2 (z-20): Strato Tipografico SEO & Interazione DOM -->
    <div
      class="pointer-events-none relative z-20 mx-auto flex w-full max-w-5xl flex-col items-center justify-center px-6 text-center"
    >
      <!-- FASE 2 (composta dalle particelle tra il 20% e il 75% dello scroll, poi consolidata nel DOM) -->
      <div
        id="hero-stage-2"
        class="gpu-accelerated pointer-events-none absolute inset-x-6 flex flex-col items-center justify-center space-y-5 sm:space-y-6"
      >
        <div
          data-particle-subreveal
          class="inline-flex max-w-full items-center gap-2 rounded-full border border-white/20 bg-white/[0.04] px-3.5 py-1 opacity-0 backdrop-blur-md [@media(max-height:700px)]:hidden"
        >
          <span class="font-mono text-[10px] tracking-widest text-white uppercase sm:text-xs">
            {hero.badge}
          </span>
        </div>

        <!-- Questo testo combacia con le lettere composte dalle particelle 3D: l'isola ne misura posizione, font e
             interlinea per campionare i punti target (righe separate da <br />, da tenere brevi) -->
        <p
          id="hero-stage-2-headline"
          class="text-metallic max-w-4xl text-4xl leading-[1.05] font-bold tracking-tight uppercase opacity-0 select-none sm:text-6xl lg:text-[4.5rem]"
        >
          {hero.particleLines[0]}<br />{hero.particleLines[1]}
        </p>

        <h1
          data-particle-subreveal
          class="max-w-3xl text-xl leading-snug font-medium tracking-tight text-[#FAFAFA] opacity-0 sm:text-3xl"
        >
          {hero.title}
        </h1>

        <p
          data-particle-subreveal
          class="max-w-2xl text-sm leading-relaxed font-normal text-[var(--text-muted)] opacity-0 sm:text-lg"
        >
          {hero.subtitle}
        </p>

        <div
          data-particle-subreveal
          class="flex flex-wrap items-center justify-center gap-3 pt-1 opacity-0 sm:gap-4"
        >
          <a
            href={hero.primaryCta.href}
            class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-medium text-[#050505] shadow-[0_0_30px_rgba(255,255,255,0.22)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-zinc-200 sm:px-7 sm:py-3.5"
          >
            {hero.primaryCta.label}
          </a>
          <a
            href={hero.secondaryCta.href}
            class="inline-flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[#0c0c0e]/90 px-6 py-3 text-sm font-medium text-white backdrop-blur-md transition-all duration-300 hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)] sm:px-7 sm:py-3.5"
          >
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>
    </div>

    <!-- Indicatore di Scroll Minimalista -->
    <div
      id="hero-scroll-hint"
      class="pointer-events-none absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-2"
    >
      <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--text-subtle)] uppercase">
        {hero.scrollHint}
      </span>
      <div class="h-9 w-[1px] bg-gradient-to-b from-white/50 to-transparent"></div>
    </div>
  </div>
</section>

<style is:global>
  /* Navbar nascosta al primo paint finché la pillola non ha concluso il fly-out (solo pagine con la Hero: questo
     CSS viaggia con il componente). html.nav-gate è impostata in <head> da MainLayout solo con JS attivo e senza
     #ancora nell'URL; la rimuovono src/lib/hero-scroll.ts (da lì in poi la navbar è guidata da GSAP) o lo script
     qui sotto se il modulo non si carica. Niente pointer-events: visibility hidden basta e il failsafe lo annulla. */
  html.nav-gate #site-header {
    opacity: 0;
    visibility: hidden;
    /* Failsafe solo CSS: se nessuno script rimuove il gate, la navbar ricompare comunque dopo 10 s */
    animation: nav-gate-failsafe 0.6s cubic-bezier(0.16, 1, 0.3, 1) 10s both;
    animation-play-state: running !important;
  }

  @keyframes nav-gate-failsafe {
    to {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  // Avvio della timeline DOM della Hero (src/lib/hero-scroll.ts): import dinamico dopo load + idle, come gsap-init
  // in MainLayout, così GSAP (chunk condiviso) resta fuori dal budget JS iniziale (< 35 KB). Indipendente dall'isola 3D.
  const NAV_GATE_CLASS = 'nav-gate';
  const wrapper = document.getElementById('hero-scrolly-wrapper');
  const ungate = () => document.documentElement.classList.remove(NAV_GATE_CLASS);
  // Failsafe se il modulo non si carica: navbar visibile e testi della Hero statici e cliccabili (come senza JS).
  // pointer-events inline come fa la timeline: il contenitore padre è pointer-events-none (proprietà ereditata).
  const failsafe = () => {
    ungate();
    const stage2 = document.getElementById('hero-stage-2');
    if (stage2) stage2.style.pointerEvents = 'auto';
    document
      .querySelectorAll<HTMLElement>('#hero-stage-2-headline, [data-particle-subreveal]')
      .forEach((el) => {
        el.style.opacity = '1';
      });
  };

  if (!wrapper) {
    ungate();
  } else {
    // Prima che il modulo sia pronto: se la pagina si apre (o viene ricaricata) già oltre la Hero, navbar visibile
    const onScroll = () => {
      if (wrapper.getBoundingClientRect().bottom <= window.innerHeight + 1) ungate();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const boot = () => {
      import('@/lib/hero-scroll')
        .then(({ initHeroScroll }) => initHeroScroll(wrapper))
        .catch(failsafe)
        .finally(() => window.removeEventListener('scroll', onScroll));
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(boot, { timeout: 2000 });
      } else {
        setTimeout(boot, 200);
      }
    };

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  }
</script>
