---
// src/components/sections/CtaSection.astro — Specifica Contenuti §3 Sezione 8 (#contatti)
// Riutilizzata dalla scheda prodotto /nzt-enterprise con copy dedicato e servizio preimpostato.
import SectionHeader from '@sections/SectionHeader.astro';
import { ContactForm } from '@interactive/ContactForm';
import { contactInfo, sectionCopy, site, type SectionCopy, type ServiceId } from '@/content/site';

interface Props {
  copy?: SectionCopy;
  defaultService?: ServiceId;
}

const { copy = sectionCopy.cta, defaultService } = Astro.props;
---

<section id="contatti" aria-labelledby="contatti-title" class="py-24 sm:py-32">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-16 px-6 lg:grid-cols-12 lg:px-8">
    <div class="space-y-10 lg:sticky lg:top-32 lg:col-span-5">
      <SectionHeader id="contatti-title" {...copy} />
      <dl
        class="space-y-4 border-t border-[var(--border-subtle)] pt-8 text-sm"
        data-animate="fade-up"
      >
        <div>
          <dt class="font-mono text-xs tracking-widest text-[var(--text-subtle)] uppercase">
            {contactInfo[0].label}
          </dt>
          <dd class="mt-1 text-[var(--text-muted)]">
            {contactInfo[0].text}
          </dd>
        </div>
        <div>
          <dt class="font-mono text-xs tracking-widest text-[var(--text-subtle)] uppercase">
            Canale diretto
          </dt>
          <dd class="mt-1">
            <a
              href={`mailto:${site.email}`}
              class="text-[#FAFAFA] underline-offset-4 hover:underline"
            >
              {site.email}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div data-animate="fade-up" class="specular-card rounded-2xl p-6 sm:p-8 lg:col-span-7">
      <ContactForm client:visible defaultService={defaultService} />
    </div>
  </div>
</section>

<script>
  import { bindServiceLinks } from '@/lib/service-links';

  bindServiceLinks();
</script>
