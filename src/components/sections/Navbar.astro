---
// src/components/sections/Navbar.astro — Specifica Contenuti §2.2, architettura grafica §5.2.1
// Header fisso 64px (glass + blur 12px). Desktop (xl+): link centrali con dropdown "Prodotti Proprietari".
// Sotto xl: menu hamburger. Script vanilla (~0.6 KB) per aria-expanded, Escape e click esterno; senza JS il
// dropdown resta raggiungibile via hover/focus-within e il link "Prodotti Proprietari" porta comunque a #prodotti.
import { buttonVariants } from '@ui/Button';
import { cn } from '@/lib/utils';
import { navLinks, primaryCta, site } from '@/content/site';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-[var(--border-subtle)] bg-[var(--bg-glass)] backdrop-blur-[12px]"
>
  <nav
    aria-label="Navigazione principale"
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6 lg:px-8"
  >
    <a href="/" class="text-sm font-semibold tracking-tight whitespace-nowrap text-[#FAFAFA]"
      >{site.name}</a
    >

    <ul class="hidden items-center gap-7 xl:flex">
      {
        navLinks.map((link) =>
          link.children ? (
            <li class="group/dd relative" data-dropdown>
              <div class="flex items-center gap-1">
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-muted)] transition-colors duration-300 ease-out-expo hover:text-[#FAFAFA]"
                >
                  {link.label}
                </a>
                <button
                  type="button"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-controls="nav-products-menu"
                  class="rounded p-1 text-[var(--text-muted)] transition-colors hover:text-[#FAFAFA] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:outline-none"
                >
                  <span class="sr-only">Mostra i prodotti</span>
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3.5 w-3.5 transition-transform duration-300 group-hover/dd:rotate-180 group-[.is-open]/dd:rotate-180"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
              </div>
              {/* pt-3 crea un "ponte" invisibile: il mouse può scendere sul pannello senza chiuderlo */}
              <div
                id="nav-products-menu"
                class="invisible absolute top-full left-1/2 w-80 -translate-x-1/2 pt-3 opacity-0 transition-[opacity,visibility] duration-200 group-focus-within/dd:visible group-focus-within/dd:opacity-100 group-hover/dd:visible group-hover/dd:opacity-100 group-[.is-open]/dd:visible group-[.is-open]/dd:opacity-100"
              >
                <ul class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-2 shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        {...(child.external ? { target: '_blank', rel: 'noopener' } : {})}
                        class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-white/[0.04] focus-visible:bg-white/[0.04] focus-visible:outline-none"
                      >
                        <span class="block text-sm font-medium text-[#FAFAFA]">
                          {child.label}
                          {child.external && <span aria-hidden="true"> ↗</span>}
                          {child.external && (
                            <span class="sr-only"> (si apre in una nuova scheda)</span>
                          )}
                        </span>
                        <span class="mt-0.5 block text-xs leading-relaxed text-[var(--text-muted)]">
                          {child.description}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class="text-sm text-[var(--text-muted)] transition-colors duration-300 ease-out-expo hover:text-[#FAFAFA]"
              >
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="flex items-center gap-2">
      {/* Area Clienti: predisposta per la Fase 2 */}
      <a
        href={site.clientAreaUrl}
        class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'hidden sm:inline-flex')}
      >
        {/* Icona lucide "lock" (v0.468) in SVG inline: 0 dipendenze, 0 KB JS */}
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Area Clienti
      </a>
      <a
        href={primaryCta.href}
        class={cn(buttonVariants({ variant: 'primary', size: 'sm' }), 'whitespace-nowrap')}
      >
        {primaryCta.label}
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group/burger inline-flex h-9 w-9 items-center justify-center rounded-lg text-[#FAFAFA] hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:outline-none xl:hidden"
      >
        <span class="sr-only">Apri il menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="h-5 w-5"
        >
          <path class="group-aria-expanded/burger:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-aria-expanded/burger:block" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* Menu mobile: nascosto finché l'hamburger non lo apre */}
  <div id="mobile-menu" hidden class="border-t border-[var(--border-subtle)] xl:hidden">
    <ul class="mx-auto max-h-[calc(100dvh-4rem)] max-w-7xl overflow-y-auto px-6 py-4">
      {
        navLinks.map((link) => (
          <li class="border-b border-[var(--border-subtle)] last:border-b-0">
            <a href={link.href} class="block py-3.5 text-base text-[#FAFAFA]">
              {link.label}
            </a>
            {link.children && (
              <ul class="-mt-1 space-y-1 pb-3 pl-4">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      {...(child.external ? { target: '_blank', rel: 'noopener' } : {})}
                      class="block py-1.5 text-sm text-[var(--text-muted)]"
                    >
                      {child.label}
                      {child.external && <span aria-hidden="true"> ↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="pt-3 sm:hidden">
        <a href={site.clientAreaUrl} class="block py-2 text-sm text-[var(--text-muted)]">
          Area Clienti
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  // Dropdown desktop "Prodotti Proprietari"
  header?.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
    const toggle = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!toggle) return;
    const setOpen = (open: boolean) => {
      dropdown.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!dropdown.classList.contains('is-open')));
    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target as Node)) setOpen(false);
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
  });

  // Menu hamburger
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (menuToggle && menu) {
    const label = menuToggle.querySelector('.sr-only');
    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      menuToggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Chiudi il menu' : 'Apri il menu';
    };
    menuToggle.addEventListener('click', () => setMenu(menu.hidden));
    // Un link scelto chiude il menu (lo scroll all'ancora lo gestisce Lenis o il browser)
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setMenu(false);
        menuToggle.focus();
      }
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', (event) => {
      if (event.matches) setMenu(false);
    });
  }
</script>
