---
// src/components/sections/SectionHeader.astro
// Intestazione di sezione condivisa: etichetta chiave come <h2> grande (text-display), frase di supporto
// (text-subhead) e lead. Rivelata con fade-up.
interface Props {
  /** id dell'<h2>, referenziato da aria-labelledby della <section> */
  id: string;
  /** Titolo chiave della sezione (mostrato grande) */
  eyebrow: string;
  /** Frase di supporto sotto il titolo */
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<div class="max-w-3xl" data-animate="fade-up">
  <h2 id={id} class="text-metallic text-display">{eyebrow}</h2>
  <p class="mt-5 text-subhead text-[#E4E4E7]">{title}</p>
  {lead && <p class="mt-5 max-w-[62ch] text-lead text-[var(--text-muted)]">{lead}</p>}
</div>
