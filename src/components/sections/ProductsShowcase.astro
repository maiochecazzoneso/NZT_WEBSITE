---
// src/components/sections/ProductsShowcase.astro — Specifica Contenuti §3 Sezione 5 (#prodotti)
// Due schede prodotto interamente cliccabili ("stretched link": l'::after del link primario copre la card).
// Scheda 2: il link secondario (Voicebot B2B) sta sopra lo strato cliccabile e preimposta 'voicebot-b2b'.
import SectionHeader from '@sections/SectionHeader.astro';
import { sectionCopy } from '@/content/site';
import { products } from '@/content/products';

const { enterprise, pnote } = products;
const stretched =
  "after:absolute after:inset-0 after:z-0 after:rounded-2xl after:content-[''] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-white/40";
---

<section
  id="prodotti"
  aria-labelledby="prodotti-title"
  class="border-b border-[var(--border-subtle)] py-24 sm:py-32"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader id="prodotti-title" {...sectionCopy.products} />

    <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {/* SCHEDA 1 — NZT Enterprise → /nzt-enterprise */}
      <article
        data-animate="fade-up"
        class="specular-card group/card relative flex flex-col rounded-2xl p-6 sm:p-10"
      >
        <span
          class="inline-flex self-start rounded-full bg-[#FAFAFA] px-3 py-1 font-mono text-[11px] tracking-widest text-[#050505] uppercase"
        >
          {enterprise.badge}
        </span>
        <h3 class="mt-8 text-3xl font-medium tracking-tight text-[#FAFAFA] sm:text-4xl">
          {enterprise.name}
        </h3>
        <p class="mt-3 font-mono text-sm leading-relaxed text-[#D4D4D8]">{enterprise.subtitle}</p>
        <p class="mt-6 leading-relaxed text-[var(--text-muted)]">{enterprise.description}</p>
        <a
          href={enterprise.cta.href}
          class:list={[
            'mt-auto inline-flex items-center gap-2 self-start pt-8 text-sm font-medium text-[#FAFAFA]',
            stretched,
          ]}
        >
          <span
            class="border-b border-white/30 pb-0.5 transition-colors group-hover/card:border-white"
          >
            {enterprise.cta.label}
          </span>
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover/card:translate-x-1"
          >
            →
          </span>
        </a>
      </article>

      {/* SCHEDA 2 — Pnote → https://pnote.it */}
      <article
        data-animate="fade-up"
        class="specular-card group/card relative flex flex-col rounded-2xl p-6 sm:p-10"
      >
        <span
          class="inline-flex self-start rounded-full border border-[var(--border-hover)] px-3 py-1 font-mono text-[11px] tracking-widest text-[#FAFAFA] uppercase"
        >
          {pnote.badge}
        </span>
        <h3 class="mt-8 text-3xl font-medium tracking-tight text-[#FAFAFA] sm:text-4xl">
          {pnote.name}
        </h3>
        <p class="mt-3 font-mono text-sm leading-relaxed text-[#D4D4D8]">{pnote.subtitle}</p>
        <p class="mt-6 leading-relaxed text-[var(--text-muted)]">{pnote.description}</p>
        <p
          class="mt-6 border-l border-white/20 pl-4 text-sm leading-relaxed text-[var(--text-muted)] italic"
        >
          {pnote.b2bNote}
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-x-8 gap-y-4 pt-8">
          <a
            href={pnote.cta.href}
            target="_blank"
            rel="noopener"
            class:list={[
              'inline-flex items-center gap-2 text-sm font-medium text-[#FAFAFA]',
              stretched,
            ]}
          >
            <span
              class="border-b border-white/30 pb-0.5 transition-colors group-hover/card:border-white"
            >
              {pnote.cta.label}
            </span>
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(si apre in una nuova scheda)</span>
          </a>
          <a
            href={pnote.secondaryCta.href}
            data-service="voicebot-b2b"
            class="relative z-10 inline-flex items-center gap-2 text-sm text-[var(--text-muted)] transition-colors hover:text-[#FAFAFA] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:outline-none"
          >
            {pnote.secondaryCta.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { initSpotlight } from '@/lib/spotlight';
  import { bindServiceLinks } from '@/lib/service-links';

  initSpotlight();
  bindServiceLinks();
</script>
