---
// src/components/sections/MethodSection.astro — architettura grafica §5.2.5 (timeline editoriale, statica)
// La numerazione monumentale (text-5xl text-zinc-800) si illumina in #FAFAFA quando lo step entra nella zona
// attiva: classe .is-active applicata da ScrollTrigger (src/lib/gsap-init.ts). WorkflowSimulator.tsx: Step 4.
import SectionHeader from '@sections/SectionHeader.astro';
import { methodSteps } from '@/content/method';
import { sectionCopy } from '@/content/site';
---

<section
  id="metodo"
  aria-labelledby="metodo-title"
  class="border-b border-[var(--border-subtle)] py-24 sm:py-32"
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-32">
        <SectionHeader id="metodo-title" {...sectionCopy.method} />
      </div>
    </div>

    <ol
      class="divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)] lg:col-span-7"
    >
      {
        methodSteps.map((step, index) => (
          <li
            data-method-step
            data-animate="fade-up"
            class="group grid grid-cols-[5rem_1fr] gap-x-6 py-10 sm:grid-cols-[6.5rem_1fr]"
          >
            <span
              aria-hidden="true"
              class="font-mono text-5xl leading-none text-zinc-800 transition-colors duration-300 ease-out-expo group-[.is-active]:text-[#FAFAFA]"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-h3 text-[#FAFAFA]">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
