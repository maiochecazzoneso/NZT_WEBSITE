---
// src/components/sections/TrustBar.astro — Specifica Contenuti §3 Sezione 2 (Pilastri tecnologici)
// Striscia statica a 4 colonne (0 KB JS): pilastro in evidenza + riga di spiegazione.
import { trustPillars } from '@/content/site';
---

<section aria-label="I pilastri di NZT Solutions" class="border-b border-[var(--border-subtle)]">
  <ul
    class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-[var(--border-subtle)] sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x"
  >
    {
      trustPillars.map((pillar, index) => (
        <li
          data-animate="fade-up"
          class:list={[
            'px-6 py-8 lg:px-8 lg:py-10',
            index % 2 === 1 && 'sm:border-l sm:border-[var(--border-subtle)] lg:border-l-0',
            index > 1 && 'sm:border-t sm:border-[var(--border-subtle)] lg:border-t-0',
          ]}
        >
          <p class="flex items-center gap-2.5 text-base font-medium tracking-tight text-[#FAFAFA]">
            <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-white" />
            {pillar.title}
          </p>
          <p class="mt-2 pl-4 text-sm leading-relaxed text-[var(--text-muted)]">{pillar.text}</p>
        </li>
      ))
    }
  </ul>
</section>
