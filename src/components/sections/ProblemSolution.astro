---
// src/components/sections/ProblemSolution.astro — architettura grafica §5.2.3 (confronto architetturale)
import SectionHeader from '@sections/SectionHeader.astro';
import { comparison, sectionCopy } from '@/content/site';

const { traditional, nzt } = comparison;
---

<section
  id="approccio"
  aria-labelledby="approccio-title"
  class="border-b border-[var(--border-subtle)] py-24 sm:py-32"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader id="approccio-title" {...sectionCopy.problem} />

    <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {
        /* Sinistra: sfondo #08080A, bordo tratteggiato rgba(255,255,255,0.06), indicatori #52525B */
      }
      <article
        data-animate="fade-up"
        class="rounded-2xl border border-dashed border-white/[0.06] bg-[#08080A] p-6 sm:p-8"
      >
        <span
          class="inline-flex rounded-full border border-dashed border-white/[0.06] px-3 py-1 font-mono text-xs tracking-widest text-[var(--text-muted)] uppercase"
        >
          {traditional.badge}
        </span>
        <h3 class="mt-6 text-h3 text-[#FAFAFA]">{traditional.title}</h3>
        <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{traditional.description}</p>
        <dl
          class="mt-8 divide-y divide-dashed divide-white/[0.06] border-y border-dashed border-white/[0.06]"
        >
          {
            traditional.metrics.map((metric) => (
              <div class="flex items-center justify-between gap-4 py-4">
                <dt class="flex items-center gap-3 font-mono text-xs tracking-widest text-[var(--text-muted)] uppercase">
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#52525B]" />
                  {metric.label}
                </dt>
                <dd class="font-mono text-sm text-[var(--text-muted)]">{metric.value}</dd>
              </div>
            ))
          }
        </dl>
      </article>

      {
        /* Destra: .specular-card, bordo continuo rgba(255,255,255,0.20), badge bianco, metriche monospace */
      }
      <article
        data-animate="fade-up"
        class="specular-card specular-card-strong rounded-2xl p-6 sm:p-8"
      >
        <span
          class="inline-flex rounded-full bg-[#FAFAFA] px-3 py-1 font-mono text-xs tracking-widest text-[#050505] uppercase"
        >
          {nzt.badge}
        </span>
        <h3 class="mt-6 text-h3 text-[#FAFAFA]">{nzt.title}</h3>
        <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{nzt.description}</p>
        <dl
          class="mt-8 divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)]"
        >
          {
            nzt.metrics.map((metric) => (
              <div class="flex items-center justify-between gap-4 py-4">
                <dt class="flex items-center gap-3 font-mono text-xs tracking-widest text-[#FAFAFA] uppercase">
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-white" />
                  {metric.label}
                </dt>
                <dd class="font-mono text-sm text-[#FAFAFA]">{metric.value}</dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>
  </div>
</section>
