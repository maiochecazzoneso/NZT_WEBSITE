---
// src/components/sections/ProblemSolution.astro — Specifica Contenuti §3 Sezione 3 (#visione)
// Confronto: modello tradizionale (bordo tratteggiato, indicatori spenti) vs approccio NZT Solutions
// (.specular-card, indicatori bianchi). Ogni punto entra con il fade-up di GSAP ScrollTrigger (gsap-init.ts).
import SectionHeader from '@sections/SectionHeader.astro';
import { comparison, sectionCopy } from '@/content/site';

const { traditional, nzt } = comparison;
---

<section
  id="visione"
  aria-labelledby="visione-title"
  class="border-b border-[var(--border-subtle)] py-24 sm:py-32"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader id="visione-title" {...sectionCopy.vision} />

    <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article
        data-animate="fade-up"
        class="rounded-2xl border border-dashed border-white/[0.06] bg-[#08080A] p-6 sm:p-8"
      >
        <span
          class="inline-flex rounded-full border border-dashed border-white/[0.06] px-3 py-1 font-mono text-xs tracking-widest text-[var(--text-muted)] uppercase"
        >
          {traditional.badge}
        </span>
        <h3 class="mt-6 text-h3 text-[var(--text-muted)]">{traditional.title}</h3>
        <ul
          class="mt-8 divide-y divide-dashed divide-white/[0.06] border-y border-dashed border-white/[0.06]"
        >
          {
            traditional.points.map((point) => (
              <li data-animate="fade-up" class="flex gap-4 py-5">
                <span
                  aria-hidden="true"
                  class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#52525B]"
                />
                <div>
                  <h4 class="font-medium text-[#D4D4D8]">{point.title}</h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">
                    {point.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>

      <article
        data-animate="fade-up"
        class="specular-card specular-card-strong rounded-2xl p-6 sm:p-8"
      >
        <span
          class="inline-flex rounded-full bg-[#FAFAFA] px-3 py-1 font-mono text-xs tracking-widest text-[#050505] uppercase"
        >
          {nzt.badge}
        </span>
        <h3 class="mt-6 text-h3 text-[#FAFAFA]">{nzt.title}</h3>
        <ul
          class="mt-8 divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)]"
        >
          {
            nzt.points.map((point) => (
              <li data-animate="fade-up" class="flex gap-4 py-5">
                <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-white" />
                <div>
                  <h4 class="font-medium text-[#FAFAFA]">{point.title}</h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">
                    {point.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
